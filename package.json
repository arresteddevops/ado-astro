{
  "name": "ado-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-redirects.mjs && node scripts/generate-og-images.mjs && node scripts/generate-social-cards.mjs && astro build && pagefind --site dist",
    "generate:redirects": "node scripts/generate-redirects.mjs",
    "generate:og": "node scripts/generate-og-images.mjs && node scripts/generate-social-cards.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@plausible-analytics/tracker": "^0.4.6",
    "astro": "^7.2.9",
    "marked": "^18.0.11",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.5.2",
    "satori": "^0.33.4",
    "sharp": "^0.35.3",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  }
}
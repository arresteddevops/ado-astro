---
const navItems = [
  { label: "Episodes", href: "/" },
  { label: "Guests", href: "/guest" },
  { label: "About", href: "/about" },
  { label: "Search", href: "/search" },
  { label: "Contact", href: "/contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Arrested DevOps home">
    <span class="brand-mark" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M6 4v12l10-6L6 4z" fill="#1e2a52"></path>
      </svg>
    </span>
    <span class="brand-name">ARRESTED DEVOPS</span>
  </a>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-panel"
    aria-label="Toggle menu"
  >
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
      <path d="M3 6h16M3 11h16M3 16h16" stroke="#fdf3e0" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  </button>

  <div class="nav-panel" id="nav-panel">
    <nav aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="pill sponsor-cta" href="/sponsorship">Sponsor us</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const panel = document.getElementById("nav-panel");

  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>

<style>
  .site-header {
    position: relative;
    /* Page content can create its own stacking context too (e.g. any
       transform: rotate(...) badge/pill), which would otherwise paint
       above this header's dropdown nav-panel since neither had an
       explicit z-index and the header comes first in the DOM. */
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px var(--page-padding);
    background: var(--color-navy);
    color: var(--color-text-on-navy);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-text-on-navy);
  }

  .brand:hover {
    color: var(--color-text-on-navy);
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
  }

  .nav-toggle {
    display: none;
    width: var(--hit-target-min);
    height: var(--hit-target-min);
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-panel ul {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-target-min);
    color: var(--color-text-on-navy);
    font-size: 14px;
    font-weight: 600;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-yellow);
  }

  .sponsor-cta {
    background: var(--color-red-deep);
    color: var(--color-text-on-navy);
  }

  .sponsor-cta:hover {
    color: var(--color-text-on-navy);
    background: color-mix(in srgb, var(--color-red-deep) 85%, black);
  }

  @media (max-width: 720px) {
    .nav-toggle {
      display: flex;
    }

    .nav-panel {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      background: var(--color-navy);
      padding: 12px var(--page-padding) 24px;
      border-top: 1px solid color-mix(in srgb, var(--color-cream) 20%, transparent);
    }

    .nav-panel.open {
      display: flex;
    }

    .nav-panel ul {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .nav-link {
      padding: 8px 0;
    }

    .sponsor-cta {
      justify-content: center;
      margin-top: 8px;
    }
  }
</style>

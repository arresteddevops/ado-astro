---
import { resolveSocialLinks } from "../lib/social";

interface Props {
  website?: string;
  twitter?: string;
  github?: string;
  linkedin?: string;
  bluesky?: string;
}

const { website, twitter, github, linkedin, bluesky } = Astro.props;
const resolved = resolveSocialLinks({ website, twitter, github, linkedin, bluesky });

const links = [
  resolved.website && { href: resolved.website, label: "Website" },
  resolved.twitter && { href: resolved.twitter, label: "Twitter" },
  resolved.github && { href: resolved.github, label: "GitHub" },
  resolved.linkedin && { href: resolved.linkedin, label: "LinkedIn" },
  resolved.bluesky && { href: resolved.bluesky, label: "Bluesky" },
].filter((l) => l !== undefined && l !== false);
---

{links.length > 0 && (
  <div class="social-links">
    {links.map((link) => (
      <a class="icon" href={link.href} aria-label={link.label} title={link.label}>
        {link.label === "Website" && (
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
          </svg>
        )}
        {link.label === "Twitter" && (
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 4l7.2 9.4L4.4 20h2.5l5.4-5.2L16.8 20H20l-7.5-9.8L18.9 4h-2.5l-4.9 4.8L7.2 4H4z" fill="currentColor"></path>
          </svg>
        )}
        {link.label === "GitHub" && (
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.16 19.5c.5.1.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2z" fill="currentColor"></path>
          </svg>
        )}
        {link.label === "LinkedIn" && (
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="2"></rect>
            <path d="M8 11v6M8 8v.01M12 17v-4a2 2 0 0 1 4 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        )}
        {link.label === "Bluesky" && (
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z" fill="currentColor"></path>
          </svg>
        )}
      </a>
    ))}
  </div>
)}

<style>
  .social-links {
    display: flex;
    gap: 10px;
  }

  .icon {
    width: var(--hit-target-min);
    height: var(--hit-target-min);
    border: 2px solid var(--color-navy);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy);
  }

  .icon:hover {
    color: var(--color-red);
    border-color: var(--color-red);
  }
</style>

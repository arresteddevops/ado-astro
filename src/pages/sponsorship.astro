---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const sponsors = (await getCollection("sponsors"))
  .filter((s) => !s.data.placeholder)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title="Sponsorship" description="Sponsor Arrested DevOps and put your product in front of the people who run production.">
  <section class="intro">
    <div class="badge">THERE'S ALWAYS MONEY IN THE PODCAST</div>
    <h1>Put your product in front of the people who run production.</h1>
    <p class="lede">
      Arrested DevOps listeners are SREs, software engineers, and IT leaders — the
      people who pick the tools. Sponsor the show and they'll hear about yours.
    </p>
  </section>

  <section class="stats">
    <div class="stat yellow">
      <span class="number">8,000+</span>
      <span class="label">DOWNLOADS OVER TIME OF EACH EPISODE</span>
    </div>
    <div class="stat navy">
      <span class="number">2,000+</span>
      <span class="label">SUBSCRIBERS IN THEIR PODCAST APP OF CHOICE</span>
    </div>
    <div class="stat red">
      <span class="number">SRE + ENG</span>
      <span class="label">AN AUDIENCE OF SRES, SOFTWARE ENGINEERS, AND IT MANAGEMENT</span>
    </div>
  </section>

  <section class="includes">
    <h2>What every sponsorship includes</h2>
    <div class="grid">
      <div class="card">
        <div class="icon yellow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3" fill="var(--color-navy)"></rect>
            <path d="M5 10v1a7 7 0 0 0 14 0v-1M12 18v4" stroke="var(--color-navy)" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </div>
        <div>
          <div class="card-title">30-second audio ad</div>
          <p>Your copy, read by a host at the top of the episode. Includes a custom landing URL so you can track what it brings you.</p>
        </div>
      </div>
      <div class="card">
        <div class="icon red">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="var(--color-cream)" stroke-width="2"></rect>
            <path d="M3 15l5-4 4 3 4-5 5 6" stroke="var(--color-cream)" stroke-width="2" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div>
          <div class="card-title">Episode banner ad</div>
          <p>Your banner on every episode you sponsor, linking to your landing page — on the site, forever.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="rates">
    <h2>Rates</h2>
    <div class="grid rates-grid">
      <div class="rate-card">
        <span class="rate-label">6 EPISODES</span>
        <span class="rate-price">$2,400</span>
        <span class="rate-sub">$400 per episode</span>
      </div>
      <div class="rate-card">
        <span class="rate-label">12 EPISODES</span>
        <span class="rate-price">$3,600</span>
        <span class="rate-sub">$300 per episode</span>
      </div>
      <div class="rate-card best">
        <span class="rate-label">24 EPISODES <span class="best-badge">BEST VALUE</span></span>
        <span class="rate-price">$5,800</span>
        <span class="rate-sub">~$242 per episode</span>
      </div>
    </div>
  </section>

  {sponsors.length > 0 && (
    <section class="sponsor-list">
      <span class="label">PREVIOUS &amp; CURRENT SPONSORS</span>
      <div class="chips">
        {sponsors.map((s) => (
          s.data.url ? <a class="chip" href={s.data.url}>{s.data.name}</a> : <span class="chip">{s.data.name}</span>
        ))}
      </div>
    </section>
  )}

  <section class="cta">
    <div>
      <h2>Ready to sponsor?</h2>
      <p>Email us and we'll get you on the schedule.</p>
    </div>
    <a class="pill" href="mailto:shows@arresteddevops.com">shows@arresteddevops.com</a>
  </section>
</BaseLayout>

<style>
  h1, h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .intro {
    padding: 64px var(--page-padding) 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 940px;
  }

  .badge {
    display: inline-flex;
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    transform: rotate(-2deg);
    align-self: flex-start;
  }

  h1 {
    font-size: 62px;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .lede {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 680px;
  }

  .stats {
    margin: 0 var(--page-padding);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .stat {
    border: var(--border-width) solid var(--color-navy);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat.yellow { background: var(--color-yellow); }
  .stat.navy { background: var(--color-navy); color: var(--color-text-on-navy); }
  .stat.red { background: var(--color-red-deep); color: var(--color-cream); }

  .stat .number {
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: 800;
  }

  .stat .label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .includes, .rates {
    padding: 56px var(--page-padding) 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .includes h2, .rates h2 {
    font-size: 30px;
    border-bottom: 3px solid var(--color-yellow);
    padding-bottom: 8px;
  }

  .rates h2 {
    border-bottom-color: var(--color-red);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .card {
    border: var(--border-width) solid var(--color-navy);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon.yellow { background: var(--color-yellow); }
  .icon.red { background: var(--color-red); }

  .card-title {
    font-size: 20px;
    font-weight: 800;
  }

  .card p {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .rates-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .rate-card {
    border: var(--border-width) solid var(--color-navy);
    border-radius: var(--radius-card);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rate-card.best {
    background: var(--color-yellow);
    box-shadow: 8px 8px 0 var(--color-navy);
  }

  .rate-label {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .rate-card.best .rate-label {
    color: var(--color-navy);
  }

  .best-badge {
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-size: 11px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .rate-price {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 800;
  }

  .rate-sub {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .sponsor-list {
    padding: 56px var(--page-padding) 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-target-min);
    border: 2px solid var(--color-navy);
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-text);
  }

  .cta {
    margin: 56px var(--page-padding) 64px;
    background: var(--color-navy);
    border-radius: var(--radius-card-lg);
    padding: 40px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    color: var(--color-text-on-navy);
  }

  .cta p {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--color-text-on-navy-muted);
  }

  .pill {
    background: var(--color-yellow);
    color: var(--color-navy);
    padding: 14px 26px;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 15px;
    flex-shrink: 0;
  }

  .pill:hover {
    color: var(--color-navy);
  }

  @media (max-width: 900px) {
    h1 { font-size: 40px; }
    .stats, .grid, .rates-grid { grid-template-columns: 1fr; }
    .cta { flex-direction: column; align-items: flex-start; }
  }
</style>

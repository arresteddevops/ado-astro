---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { getEpisodesByGuestId } from "../../lib/guests";
import { renderMarkdown } from "../../lib/markdown";
import { getMiscAsset } from "../../lib/images";

export async function getStaticPaths() {
  const guests = await getCollection("guests");
  const episodesByGuest = await getEpisodesByGuestId();
  return guests.map((guest) => ({
    params: { slug: guest.id },
    props: { guest, episodes: episodesByGuest.get(guest.id) ?? [] },
  }));
}

const { guest, episodes } = Astro.props;
const latest = guest.data.snapshots[guest.data.snapshots.length - 1];
const initials = guest.data.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((p) => p[0]?.toUpperCase())
  .join("");

const sortedEpisodes = [...episodes].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const firstAppeared = sortedEpisodes[0]?.data.date.getFullYear();
const bioHtml = renderMarkdown(latest.bio);
const image = getMiscAsset(latest.thumbnail);
---

<BaseLayout title={guest.data.name} description={latest.bio.slice(0, 160)}>
  <section class="profile" data-pagefind-body data-pagefind-filter="type:Guest">
    <div class="card" data-pagefind-meta={`episodeCount:${episodes.length}`}>
      <div class="avatar" aria-hidden="true">
        {image ? (
          <Image src={image} alt="" width={320} height={320} data-pagefind-meta="image[src]" />
        ) : (
          initials
        )}
      </div>
      <div class="badge">GUEST</div>
      <h1>{guest.data.name}</h1>
      <SocialLinks website={latest.website} twitter={latest.twitter} github={latest.github} linkedin={latest.linkedin} />
    </div>

    <div class="bio-block">
      <div class="bio" set:html={bioHtml} />
      <div class="stats">
        <div class="stat">
          <span class="stat-number">{episodes.length}</span>
          <span class="stat-label">EPISODES</span>
        </div>
        {firstAppeared && (
          <div class="stat">
            <span class="stat-number">{firstAppeared}</span>
            <span class="stat-label">FIRST APPEARED</span>
          </div>
        )}
      </div>
    </div>
  </section>

  {episodes.length > 0 && (
    <section class="episodes">
      <h2>Episodes featuring {guest.data.name}</h2>
      <div class="list">
        {sortedEpisodes.slice().reverse().map((episode) => (
          <a class="row" href={`/${episode.id}/`}>
            <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
              <circle cx="17" cy="17" r="16" stroke="var(--color-navy)" stroke-width="2.5"></circle>
              <path d="M13 11v12l10-6-10-6z" fill="var(--color-navy)"></path>
            </svg>
            <span class="title">{episode.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  h1, h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .profile {
    padding: 56px var(--page-padding) 40px;
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }

  .card {
    width: 380px;
    flex-shrink: 0;
    border: var(--border-width) solid var(--color-navy);
    border-radius: var(--radius-card-lg);
    box-shadow: 8px 8px 0 var(--color-yellow);
    padding: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    background: var(--color-cream-card);
  }

  .avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.12em;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    transform: rotate(-2deg);
  }

  .card h1 {
    font-size: 32px;
    text-align: center;
  }

  .bio-block {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 12px;
    flex: 1;
    min-width: 0;
  }

  .bio {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
  }

  .bio :global(p) {
    margin: 0 0 16px;
  }

  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  .bio :global(a) {
    color: var(--color-red-deep);
  }

  .stats {
    display: flex;
    gap: 24px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    color: var(--color-red);
  }

  .stat-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .episodes {
    padding: 8px var(--page-padding) 64px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .episodes h2 {
    font-size: 28px;
    border-bottom: 3px solid var(--color-red);
    padding-bottom: 8px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    border: var(--border-width) solid var(--color-navy);
    border-radius: 16px;
    padding: 18px 26px;
    display: flex;
    align-items: center;
    gap: 20px;
    color: var(--color-text);
  }

  .row:hover .title {
    color: var(--color-red-deep);
  }

  .title {
    font-size: 18px;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .profile {
      flex-direction: column;
      align-items: center;
    }

    .card {
      width: 100%;
    }
  }
</style>

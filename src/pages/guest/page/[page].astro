---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PersonCard from "../../../components/PersonCard.astro";
import { getEpisodesByGuestId, getGuestsSorted, GUESTS_PER_PAGE } from "../../../lib/guests";

export async function getStaticPaths() {
  const guests = await getGuestsSorted();
  const totalPages = Math.ceil(guests.length / GUESTS_PER_PAGE);

  // Page 1 lives at /guest/ (see guest/index.astro) — this route only
  // covers 2..totalPages, matching the episode list's /page/N/ scheme.
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const pageNumber = i + 2;
    const start = (pageNumber - 1) * GUESTS_PER_PAGE;
    return {
      params: { page: String(pageNumber) },
      props: {
        guests: guests.slice(start, start + GUESTS_PER_PAGE),
        pageNumber,
        totalPages,
      },
    };
  });
}

const { guests, pageNumber, totalPages } = Astro.props;
const episodesByGuest = await getEpisodesByGuestId();
---

<BaseLayout title={`Guests — page ${pageNumber}`} description={`Browse Arrested DevOps guests — page ${pageNumber} of ${totalPages}.`}>
  <section class="intro">
    <h1>Guests</h1>
    <div class="grid">
      {guests.map((guest, i) => {
        const latest = guest.data.snapshots[guest.data.snapshots.length - 1];
        const count = episodesByGuest.get(guest.id)?.length ?? 0;
        return (
          <PersonCard
            name={guest.data.name}
            bio={latest.bio}
            thumbnail={latest.thumbnail}
            href={`/guest/${guest.id}/`}
            episodeCount={count}
            colorIndex={i}
          />
        );
      })}
    </div>
    <nav class="pager" aria-label="Guest pages">
      <a class="pill outline" href={pageNumber === 2 ? "/guest/" : `/guest/page/${pageNumber - 1}/`}>← Previous</a>
      <span class="page-indicator">Page {pageNumber} of {totalPages}</span>
      {pageNumber < totalPages && <a class="pill outline" href={`/guest/page/${pageNumber + 1}/`}>Next →</a>}
    </nav>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 48px;
  }

  .intro {
    padding: 56px var(--page-padding) 64px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-target-min);
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-text);
  }

  .pill.outline {
    border: 2px solid var(--color-navy);
  }

  .page-indicator {
    font-size: 14px;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

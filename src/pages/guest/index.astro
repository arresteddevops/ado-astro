---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import { getEpisodesByGuestId, getGuestsSorted, GUESTS_PER_PAGE } from "../../lib/guests";

const allGuests = await getGuestsSorted();
const guests = allGuests.slice(0, GUESTS_PER_PAGE);
const totalPages = Math.ceil(allGuests.length / GUESTS_PER_PAGE);
const episodesByGuest = await getEpisodesByGuestId();
---

<BaseLayout title="Guests" description={`Every guest who has appeared on Arrested DevOps — ${allGuests.length} and counting.`}>
  <section class="intro">
    <div class="badge">THE WHOLE FAMILY</div>
    <h1>{allGuests.length} guests and counting.</h1>
    <p class="lede">
      Everyone who's ever joined the show — engineers, authors, organizers, and at least
      one cloud economist.
    </p>
  </section>

  <section class="grid">
    {guests.map((guest, i) => {
      const latest = guest.data.snapshots[guest.data.snapshots.length - 1];
      const count = episodesByGuest.get(guest.id)?.length ?? 0;
      return (
        <PersonCard
          name={guest.data.name}
          bio={latest.bio}
          thumbnail={latest.thumbnail}
          href={`/guest/${guest.id}/`}
          episodeCount={count}
          colorIndex={i}
        />
      );
    })}
  </section>

  {totalPages > 1 && (
    <nav class="pager" aria-label="Guest pages">
      <span class="page-indicator">Page 1 of {totalPages}</span>
      <a class="pill outline" href="/guest/page/2/">Next →</a>
    </nav>
  )}
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
  }

  .intro {
    padding: 64px var(--page-padding) 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .badge {
    display: inline-flex;
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    transform: rotate(-2deg);
    align-self: flex-start;
  }

  .lede {
    margin: 0;
    font-size: 18px;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.55;
  }

  .grid {
    padding: 16px var(--page-padding) 24px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 0 var(--page-padding) 64px;
  }

  .pill.outline {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-target-min);
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-navy);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-text);
  }

  .page-indicator {
    font-size: 14px;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 40px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

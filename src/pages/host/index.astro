---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import { getEpisodesByHostId } from "../../lib/hosts";

const hosts = (await getCollection("hosts")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const episodesByHost = await getEpisodesByHostId();
---

<BaseLayout title="Hosts" description="The hosts of Arrested DevOps, past and present.">
  <section class="intro">
    <div class="badge">THE CREW</div>
    <h1>{hosts.length} hosts.</h1>
    <p class="lede">The voices behind the mic, past and present.</p>
  </section>

  <section class="grid">
    {hosts.map((host, i) => {
      const count = episodesByHost.get(host.id)?.length ?? 0;
      return (
        <PersonCard
          name={host.data.name}
          bio={host.body ?? ""}
          href={`/host/${host.id}/`}
          episodeCount={count}
          colorIndex={i}
        />
      );
    })}
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
  }

  .intro {
    padding: 64px var(--page-padding) 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .badge {
    display: inline-flex;
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    transform: rotate(-2deg);
    align-self: flex-start;
  }

  .lede {
    margin: 0;
    font-size: 18px;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.55;
  }

  .grid {
    padding: 16px var(--page-padding) 64px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 40px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

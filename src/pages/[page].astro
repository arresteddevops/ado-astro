---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // "sponsorship" and "contact" have their own dedicated, custom-designed
  // pages (sponsorship.astro, contact.astro) — excluded here to avoid two
  // routes claiming the same path. (Astro's static-path extraction runs this
  // function in isolation, so the set lives inside it, not at module scope.)
  const dedicatedPages = new Set(["sponsorship", "contact"]);
  const pages = await getCollection("pages", (p) => !dedicatedPages.has(p.id));
  return pages.map((page) => ({
    params: { page: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="page">
    <h1>{page.data.title}</h1>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 48px;
  }

  .page {
    padding: 56px var(--page-padding) 64px;
    max-width: var(--content-max-width);
  }

  .body {
    line-height: 1.7;
    color: var(--color-text);
  }

  .body :global(h2) {
    font-family: var(--font-display);
    font-size: 26px;
    margin-top: 32px;
  }

  .body :global(a) {
    color: var(--color-red-deep);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 32px;
    }
  }
</style>

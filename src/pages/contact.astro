---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Get in touch with Arrested DevOps.">
  <section class="intro">
    <div class="badge">SAY HELLO</div>
    <h1>We've made a huge mistake… said no one who emailed us.</h1>
  </section>

  <section class="content">
    <form class="form" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="subject" value="New message from the Arrested DevOps contact form" />
      <p class="honeypot" aria-hidden="true">
        <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <h2>Drop us a line</h2>
      <div class="row">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>
      </div>
      <div class="field">
        <label for="message">What's up</label>
        <textarea id="message" name="message" rows="5" placeholder="Episode idea, feedback, corrections, kind words, gentle heckling…" required></textarea>
      </div>
      <button type="submit" class="pill submit">Send it</button>
    </form>

    <div class="channels">
      <div class="channel-card">
        <div class="icon yellow">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2" stroke="var(--color-navy)" stroke-width="2"></rect>
            <path d="M2 7l10 7 10-7" stroke="var(--color-navy)" stroke-width="2" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div>
          <div class="channel-title">Email</div>
          <a href="mailto:shows@arresteddevops.com">shows@arresteddevops.com</a>
        </div>
      </div>
      <div class="channel-card">
        <div class="icon red">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L12 3z" stroke="var(--color-cream)" stroke-width="2" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div>
          <div class="channel-title">Social</div>
          <span class="muted">@ArrestedDevOps, most places</span>
        </div>
      </div>
      <div class="channel-card highlight">
        <div class="icon navy">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3" fill="var(--color-yellow)"></rect>
            <path d="M5 10v1a7 7 0 0 0 14 0v-1M12 18v4" stroke="var(--color-yellow)" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </div>
        <div>
          <div class="channel-title">Want to be a guest?</div>
          <a href="mailto:shows@arresteddevops.com">Pitch an episode idea →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1, h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .intro {
    padding: 64px var(--page-padding) 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 800px;
  }

  .badge {
    display: inline-flex;
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    transform: rotate(-2deg);
    align-self: flex-start;
  }

  h1 {
    font-size: 62px;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .content {
    padding: 24px var(--page-padding) 64px;
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  .form {
    flex: 1;
    border: var(--border-width) solid var(--color-navy);
    border-radius: var(--radius-card-lg);
    box-shadow: 8px 8px 0 var(--color-yellow);
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--color-cream-card);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  .row {
    display: flex;
    gap: 14px;
  }

  .field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-text);
  }

  input, textarea {
    border: 2px solid var(--color-navy);
    border-radius: 12px;
    padding: 13px 16px;
    font-size: 15px;
    font-family: inherit;
    background: var(--color-cream);
    color: var(--color-text);
    min-height: var(--hit-target-min);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit {
    align-self: flex-start;
    background: var(--color-navy);
    color: var(--color-cream);
    padding: 13px 28px;
    border: none;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 15px;
    min-height: var(--hit-target-min);
  }

  .channels {
    width: 420px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .channel-card {
    border: var(--border-width) solid var(--color-navy);
    border-radius: var(--radius-card);
    padding: 26px;
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .channel-card.highlight {
    background: var(--color-yellow);
  }

  .icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon.yellow { background: var(--color-yellow); }
  .icon.red { background: var(--color-red); }
  .icon.navy { background: var(--color-navy); }

  .channel-title {
    font-size: 16px;
    font-weight: 800;
  }

  .muted {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    h1 { font-size: 40px; }

    .content {
      flex-direction: column;
    }

    .channels {
      width: 100%;
    }

    .row {
      flex-direction: column;
    }
  }
</style>

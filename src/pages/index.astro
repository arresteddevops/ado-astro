---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import { getEpisodesNewestFirst, EPISODES_PER_PAGE } from "../lib/episodes";
import { SUBSCRIBE_LINKS } from "../consts";
import { getEpisodeAsset } from "../lib/images";

const episodes = await getEpisodesNewestFirst();
const [latest, ...rest] = episodes;
const gridEpisodes = rest.slice(0, EPISODES_PER_PAGE - 1);
const totalPages = Math.ceil(episodes.length / EPISODES_PER_PAGE);
const latestImage = getEpisodeAsset(latest.data.episodeImage);
---

<BaseLayout
  title="Arrested DevOps: DevOps Conversations, Interviews & Real Talk"
  suffixTitle={false}
  image="/img/social/og/home.jpg"
>
  <section class="hero">
    <div class="hero-copy">
      <div class="badge">
        <span class="dot"></span>
        ON AIR SINCE 2013
      </div>
      <h1>There's always a DevOps episode in the banana&nbsp;stand.</h1>
      <p class="lede">
        The podcast that helps you achieve understanding, develop good practices, and
        operate your team for maximum DevOps awesomeness. {episodes.length} episodes and
        counting.
      </p>
      <div class="cta-row">
        <a class="pill listen" href={`/${latest.id}/`}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 2.5v11l9-5.5-9-5.5z" fill="var(--color-yellow)"></path>
          </svg>
          Listen to the latest
        </a>
        <a class="pill outline" href="#episodes">Browse episodes</a>
      </div>
    </div>
    <a class="hero-card" href={`/${latest.id}/`}>
      <div class="hero-card-image">
        {latestImage ? (
          <Image src={latestImage} alt="" width={380} height={220} />
        ) : (
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3" fill="var(--color-navy)"></rect>
            <path d="M5 10v1a7 7 0 0 0 14 0v-1M12 18v4M8 22h8" stroke="var(--color-navy)" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        )}
        <span class="ep-number">EP. {latest.data.episodeNumber}</span>
      </div>
      <span class="ep-title">{latest.data.title}</span>
    </a>
  </section>

  <section class="subscribe-row">
    <span class="label">LISTEN ON</span>
    <a class="pill outline small" href={SUBSCRIBE_LINKS.apple}>Apple Podcasts</a>
    <a class="pill outline small" href={SUBSCRIBE_LINKS.spotify}>Spotify</a>
    <a class="pill outline small" href={SUBSCRIBE_LINKS.pocketcasts}>PocketCasts</a>
    <a class="pill outline small" href={SUBSCRIBE_LINKS.android}>Android</a>
    <a class="pill rss" href={SUBSCRIBE_LINKS.rss}>RSS</a>
  </section>

  <section class="episodes" id="episodes">
    <h2>Previously on Arrested DevOps…</h2>
    <div class="grid">
      {gridEpisodes.map((episode, i) => <EpisodeCard episode={episode} colorIndex={i} />)}
    </div>
    {totalPages > 1 && (
      <div class="pager">
        <a class="pill outline" href="/page/2/">Older episodes →</a>
      </div>
    )}
  </section>

  <section class="guests-cta">
    <div>
      <h2>Guests. Zero gatekeeping.</h2>
      <p>From SREs to CTOs to people who were just really good at breaking things — browse everyone who's been on the show.</p>
    </div>
    <a class="pill cta" href="/guest">Meet the guests</a>
  </section>
</BaseLayout>

<style>
  h1, h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .hero {
    padding: 72px var(--page-padding) 40px;
    display: flex;
    gap: 48px;
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-red-deep);
    color: var(--color-cream);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.12em;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    transform: rotate(-2deg);
    align-self: flex-start;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--color-cream);
    border-radius: 50%;
  }

  h1 {
    font-size: 74px;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .lede {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 560px;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--hit-target-min);
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-text);
  }

  .pill.listen {
    background: var(--color-navy);
    color: var(--color-cream);
  }

  .pill.listen:hover {
    color: var(--color-cream);
    background: color-mix(in srgb, var(--color-navy) 85%, black);
  }

  .pill.outline {
    border: 2px solid var(--color-navy);
  }

  .pill.small {
    padding: 9px 18px;
    font-size: 13px;
  }

  .pill.rss {
    background: var(--color-red-deep);
    color: var(--color-cream);
    border: 2px solid var(--color-red-deep);
    padding: 9px 18px;
    font-size: 13px;
  }

  .pill.rss:hover {
    color: var(--color-cream);
  }

  .pill.cta {
    background: var(--color-yellow);
    color: var(--color-navy);
    font-weight: 800;
    flex-shrink: 0;
  }

  .pill.cta:hover {
    color: var(--color-navy);
  }

  .hero-card {
    width: 380px;
    background: var(--color-yellow);
    border-radius: var(--radius-card-lg);
    border: var(--border-width) solid var(--color-navy);
    box-shadow: 10px 10px 0 var(--color-navy);
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
    transform: rotate(2deg);
    padding: 24px;
    color: var(--color-text);
  }

  .hero-card:hover {
    color: var(--color-text);
  }

  .hero-card:hover .ep-title {
    color: var(--color-red-deep);
  }

  .hero-card-image {
    position: relative;
    height: 220px;
    margin: -24px -24px 0;
    border-radius: var(--radius-card-lg) var(--radius-card-lg) 0 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-card-image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ep-number {
    position: relative;
    align-self: flex-start;
    margin: 12px 0 0 12px;
    background: var(--color-navy);
    color: var(--color-yellow);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
  }

  .ep-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--color-navy);
    text-align: center;
  }

  .subscribe-row {
    padding: 0 var(--page-padding) 48px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .episodes {
    padding: 24px var(--page-padding) 64px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .pager {
    display: flex;
    justify-content: center;
    margin-top: 12px;
  }

  .guests-cta {
    margin: 0 var(--page-padding) 64px;
    background: var(--color-navy);
    border-radius: var(--radius-card-lg);
    padding: 40px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    color: var(--color-text-on-navy);
  }

  .guests-cta p {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--color-text-on-navy-muted);
    max-width: 560px;
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
    }

    h1 {
      font-size: 48px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .guests-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
